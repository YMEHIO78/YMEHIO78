{
  "datasets": [
    {
      "name": "ds_coverage",
      "displayName": "Skill coverage",
      "queryLines": [
        "SELECT skill, people, deep_practitioners, avg_proficiency, learning_hours,",
        "       is_critical, held_by,",
        "       CASE WHEN is_critical AND deep_practitioners <= 1 THEN 1 ELSE 0 END AS no_backup",
        "FROM skills_analysis.main.skill_coverage"
      ]
    },
    {
      "name": "ds_certifications",
      "displayName": "Certifications",
      "queryLines": [
        "SELECT name, team, certification, cost_usd, expires_on, days_to_expiry, risk_band,",
        "       CASE WHEN days_to_expiry <= 90 THEN 1 ELSE 0 END AS at_risk",
        "FROM skills_analysis.main.certifications"
      ]
    }
  ],
  "pages": [
    {
      "name": "skills_intelligence",
      "displayName": "Skills Intelligence",
      "layout": [
        {
          "widget": {
            "name": "header",
            "textbox_spec": "# Skills Intelligence\n\nFour numbers worth watching every week, from a 30-person engineering organisation.\n\n**A skill is covered** when more than one person is at proficiency 4+ \u2014 enough to carry it without help. Use the filters to narrow by criticality or team."
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "filter_critical",
            "queries": [
              {
                "name": "filter_query",
                "query": {
                  "datasetName": "ds_coverage",
                  "fields": [
                    {
                      "name": "is_critical",
                      "expression": "`is_critical`"
                    },
                    {
                      "name": "is_critical_associativity",
                      "expression": "COUNT_IF(`associative_filter_predicate_group`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-single-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "is_critical",
                    "displayName": "Critical skills only",
                    "queryName": "filter_query"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Critical skills only"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 3,
            "width": 3,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "filter_team",
            "queries": [
              {
                "name": "filter_query",
                "query": {
                  "datasetName": "ds_certifications",
                  "fields": [
                    {
                      "name": "team",
                      "expression": "`team`"
                    },
                    {
                      "name": "team_associativity",
                      "expression": "COUNT_IF(`associative_filter_predicate_group`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "team",
                    "displayName": "Team",
                    "queryName": "filter_query"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Team"
              }
            }
          },
          "position": {
            "x": 3,
            "y": 3,
            "width": 3,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "kpi_no_backup",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_coverage",
                  "fields": [
                    {
                      "name": "critical_skills_without_backup",
                      "expression": "SUM(`no_backup`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "critical_skills_without_backup",
                  "displayName": "Critical skills with no backup"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Critical skills with no backup",
                "showDescription": true,
                "description": "Critical skills where one person or nobody is at proficiency 4+. Target 0."
              }
            }
          },
          "position": {
            "x": 0,
            "y": 5,
            "width": 3,
            "height": 5
          }
        },
        {
          "widget": {
            "name": "kpi_certs",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_certifications",
                  "fields": [
                    {
                      "name": "certifications_at_risk",
                      "expression": "SUM(`at_risk`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "certifications_at_risk",
                  "displayName": "Certifications at risk"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Certifications at risk",
                "showDescription": true,
                "description": "Expired, or lapsing within 90 days. Target 0 \u2014 renewals need lead time."
              }
            }
          },
          "position": {
            "x": 3,
            "y": 5,
            "width": 3,
            "height": 5
          }
        },
        {
          "widget": {
            "name": "kpi_gap_hours",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_coverage",
                  "fields": [
                    {
                      "name": "pct_hours_to_exposed_skills",
                      "expression": "ROUND(100.0 * SUM(CASE WHEN `no_backup` = 1 THEN `learning_hours` ELSE 0 END) / NULLIF(SUM(`learning_hours`), 0), 1)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "pct_hours_to_exposed_skills",
                  "displayName": "% of learning hours on exposed skills"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "% of learning hours on exposed skills",
                "showDescription": true,
                "description": "Share of learning time going to the skills that rest on one person or nobody. Should rise until the backup count reaches zero."
              }
            }
          },
          "position": {
            "x": 0,
            "y": 10,
            "width": 3,
            "height": 5
          }
        },
        {
          "widget": {
            "name": "kpi_depth",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_coverage",
                  "fields": [
                    {
                      "name": "people_at_depth",
                      "expression": "SUM(`deep_practitioners`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "people_at_depth",
                  "displayName": "People at proficiency 4+"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "People at proficiency 4+",
                "showDescription": true,
                "description": "Total depth across the skills in view. The number that has to go up for the other three to improve."
              }
            }
          },
          "position": {
            "x": 3,
            "y": 10,
            "width": 3,
            "height": 5
          }
        },
        {
          "widget": {
            "name": "chart_depth",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_coverage",
                  "fields": [
                    {
                      "name": "skill",
                      "expression": "`skill`"
                    },
                    {
                      "name": "deep_practitioners",
                      "expression": "SUM(`deep_practitioners`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "deep_practitioners",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "People at proficiency 4+"
                },
                "y": {
                  "fieldName": "skill",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Skill"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Where capability is concentrated",
                "showDescription": true,
                "description": "Bars at zero or one are a single unplanned absence away from a gap."
              }
            }
          },
          "position": {
            "x": 0,
            "y": 15,
            "width": 6,
            "height": 8
          }
        },
        {
          "widget": {
            "name": "chart_hours",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_coverage",
                  "fields": [
                    {
                      "name": "skill",
                      "expression": "`skill`"
                    },
                    {
                      "name": "learning_hours",
                      "expression": "SUM(`learning_hours`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "learning_hours",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Learning hours, last 12 months"
                },
                "y": {
                  "fieldName": "skill",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Skill"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Where learning time went",
                "showDescription": true,
                "description": "Compare against the chart above: investment should follow the gaps."
              }
            }
          },
          "position": {
            "x": 0,
            "y": 23,
            "width": 6,
            "height": 8
          }
        },
        {
          "widget": {
            "name": "table_certs",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_certifications",
                  "fields": [
                    {
                      "name": "name",
                      "expression": "`name`"
                    },
                    {
                      "name": "team",
                      "expression": "`team`"
                    },
                    {
                      "name": "certification",
                      "expression": "`certification`"
                    },
                    {
                      "name": "risk_band",
                      "expression": "`risk_band`"
                    },
                    {
                      "name": "expires_on",
                      "expression": "`expires_on`"
                    },
                    {
                      "name": "days_to_expiry",
                      "expression": "`days_to_expiry`"
                    },
                    {
                      "name": "cost_usd",
                      "expression": "`cost_usd`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 1,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "name",
                    "displayName": "Worker",
                    "type": "string",
                    "visible": true,
                    "order": 0
                  },
                  {
                    "fieldName": "team",
                    "displayName": "Team",
                    "type": "string",
                    "visible": true,
                    "order": 1
                  },
                  {
                    "fieldName": "certification",
                    "displayName": "Certification",
                    "type": "string",
                    "visible": true,
                    "order": 2
                  },
                  {
                    "fieldName": "risk_band",
                    "displayName": "Status",
                    "type": "string",
                    "visible": true,
                    "order": 3
                  },
                  {
                    "fieldName": "expires_on",
                    "displayName": "Expires",
                    "type": "string",
                    "visible": true,
                    "order": 4
                  },
                  {
                    "fieldName": "days_to_expiry",
                    "displayName": "Days",
                    "type": "string",
                    "visible": true,
                    "order": 5
                  },
                  {
                    "fieldName": "cost_usd",
                    "displayName": "Cost $",
                    "type": "string",
                    "visible": true,
                    "order": 6
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Certification pipeline",
                "showDescription": true,
                "description": "Soonest to lapse first."
              }
            }
          },
          "position": {
            "x": 0,
            "y": 31,
            "width": 6,
            "height": 8
          }
        }
      ]
    }
  ]
}
