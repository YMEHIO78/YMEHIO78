/// Date table. Runs from 1 Jan of the first order year to the last order date, so a
/// part-year is compared with the same part of the year before.
table Calendar
	lineageTag: 212c82d8-7212-56ec-b407-b26f3828d923
	dataCategory: Time

	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		isKey
		lineageTag: 559ef055-5b15-58c2-8669-9804db4af44d
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 7d4dc201-ab82-5604-9dd3-d1128cf957ec
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column Quarter
		dataType: string
		lineageTag: 1a04441b-3c1c-516c-ad17-a475cde253eb
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

		annotation SummarizationSetBy = Automatic

	column 'Month Number'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 812df11e-0b6f-53be-a315-a7d46133565b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Number]

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		sortByColumn: 'Month Number'
		lineageTag: 9300e4ea-7288-5d66-bd48-404aef7615ae
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]

		annotation SummarizationSetBy = Automatic

	column 'Year Month Key'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: a0117f83-23ee-59ec-810d-4ae778fa3f1b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month Key]

		annotation SummarizationSetBy = Automatic

	column 'Year Month'
		dataType: string
		sortByColumn: 'Year Month Key'
		lineageTag: c66761cd-021a-59d2-9ff1-96015f904d70
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month]

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source =
				VAR FirstDay = DATE ( YEAR ( MIN ( Sales[Order Date] ) ), 1, 1 )
				VAR LastDay = MAX ( Sales[Order Date] )
				RETURN
					ADDCOLUMNS (
						CALENDAR ( FirstDay, LastDay ),
						"Year", YEAR ( [Date] ),
						"Quarter", "Q" & QUARTER ( [Date] ),
						"Month Number", MONTH ( [Date] ),
						"Month", FORMAT ( [Date], "mmm" ),
						"Year Month Key", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
						"Year Month", FORMAT ( [Date], "mmm yyyy" )
					)
