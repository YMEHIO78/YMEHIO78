model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	annotation __PBI_TimeIntelligenceEnabled = 0

	annotation PBI_QueryOrder = ["DataFolder","Sales","Geography","Products","Targets"]

ref table Sales
ref table Geography
ref table Products
ref table Targets
ref table Calendar
